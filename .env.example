# Backend (copy to .env — never commit real secrets)
ENV=development
CORS_ORIGINS=*
# SCHEMES_PATH=  # optional; must stay under repo /app data roots
# LLM_API_KEY=
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_SEC=60
# MAX_BODY_BYTES=65536
# REDIS_URL=redis://localhost:6379/0
# MATCH_CACHE_TTL_SEC=0
# Frontend (frontend/.env.local): leave empty for same-origin Next.js /api
# NEXT_PUBLIC_API_URL=
# Optional Upstash REST for Vercel multi-instance rate limits:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
